{
  "schemaVersion": 1,
  "name": "Mass Effect 3 squad power wheel",
  "status": "focused-native-verified",
  "reference": {
    "visual": "https://cdn.shazoo.ru/31253_M1WMOW2NSS_pgw_omega_205_1.jpg",
    "publication": "https://shazoo.ru/2012/11/07/11047/mass-effect-3-omega-dlc-pervye-skrinshoty",
    "controls": "https://eaassets-a.akamaihd.net/eahelp/manuals/mass-effect-3-manuals_Microsoft%20XBOX360.pdf",
    "scope": "Original ME3 console radial power layout, adapted to Windows mouse/keyboard. Recreated geometry/glyphs and substituted typeface; deterministic mixed-class Shepard powers for authoring coverage."
  },
  "referenceViewport": [
    1920,
    1080
  ],
  "umg": [
    {
      "name": "PowerWheelOverlay",
      "type": "UOverlay",
      "role": "Code-created full-screen root"
    },
    {
      "name": "CombatDimmer",
      "type": "UBorder",
      "role": "Tint the live paused gym scene; hit-test invisible"
    },
    {
      "name": "SafeZone",
      "type": "USafeZone",
      "role": "Device-safe layout"
    },
    {
      "name": "ReferenceScale",
      "type": "UScaleBox",
      "role": "ScaleToFit; preserve wheel shape at 720p, 1080p and ultrawide"
    },
    {
      "name": "ReferenceViewport",
      "type": "USizeBox",
      "role": "1920x1080 authored coordinate space"
    },
    {
      "name": "AuthoredWheel",
      "type": "UCk_UI_AuthoredSurface_UE",
      "role": "Admit committed main region, revoke owner interactions on close"
    }
  ],
  "nativeParts": [
    {
      "part": "radial-selector",
      "role": "Retained native interaction and broken circular frame; each item owns a framed vector power glyph"
    },
    {
      "part": "selection",
      "role": "Cyan hover/keyboard selection; blocked items remain inspectable"
    },
    {
      "part": "queue",
      "role": "Amber ring marks one queued power per actor"
    },
    {
      "part": "cooldown",
      "role": "Gray progress veil from the typed shared actor cooldown; frozen while wheel is open"
    },
    {
      "part": "availability",
      "role": "Red glyph when blocked/unavailable, no activation callback"
    },
    {
      "part": "content-slot",
      "role": "Authored title and reticle centered within the transparent circle"
    },
    {
      "part": "squad-portraits",
      "role": "Reuse Garrus/Liara two-part atlas; authored image leaves sit in bordered portrait-frame columns with queue readouts"
    },
    {
      "part": "vitals",
      "role": "Native curved shield/health art below wheel; fixture values"
    },
    {
      "part": "fade",
      "role": "UMG opacity rises over 0.14 real seconds independently of world pause"
    },
    {
      "part": "focus",
      "role": "Native radial selector suppresses the default full-widget Slate focus rectangle; its selected glyph frame remains visible focus feedback."
    }
  ],
  "data": {
    "actors": [
      "Shepard",
      "Garrus",
      "Liara"
    ],
    "powers": 16,
    "fields": {
      "actor": "Text",
      "glyph": "Text",
      "label": "Text",
      "angle": "Number degrees clockwise",
      "cooldown": "Number normalized 0..1",
      "enabled": "Bool",
      "queued": "Bool"
    },
    "selectionBinding": "Selection",
    "selectionEvent": "SelectPower",
    "queueEvent": "QueuePower",
    "deployment": "Release revalidates the entire queue before returning any commands; no gameplay callbacks in this deterministic fixture"
  },
  "ownership": {
    "pause": "Acquire only if world unpaused; release only owned pause",
    "input": "Scoped Slate user; Shift hold/release and native tile hover/click or arrow/Enter; cancel on Escape, Tab, app deactivation, shutdown",
    "reload": "Typed parse and source topology validation before retained reload; rejection keeps accepted view and queue",
    "resources": "Loose HTML/CSS staged NonUFS; shared portraits are already staged; no Widget Blueprint"
  },
