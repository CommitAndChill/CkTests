  "visualInspectionManifestSha256": "75e6be73f0c6138127b295826e5ae225e7dbdf803b73a1d36a29f97d4bd5e82e",
  "scope": "Reflected named-font initialization and actual AngelScript card consumer, retained resource ownership and atomic failures, with compatible authoring checks.",
  "capabilities": [
    "Script declares card-ui Regular/Bold and fallback files in the reflected session config without a new C++ screen host.",
    "Mounted title/subtitle resolve the same named composite with explicit Bold/Regular faces and exact expected font bytes; unstyled labels retain Core font.",
    "Session registration rejects invalid declarations and missing/malformed resources atomically and permits corrected initialization retry.",
    "Unknown-family and unavailable-Bold reloads preserve accepted root/revision/model; corrected reload succeeds.",
    "Retained text keeps inline primary/fallback assets and bytes alive after config/session release and GC."
  ],
  "limitations": [
    "Development Editor file paths only; installed-plugin lookup and packaged resource acceptance remain unverified.",
    "The card deliberately pairs Roboto Condensed Regular with Roboto Bold; its Droid Sans fallback uses the same source file for both named faces.",
    "Font validation proves available faces open, not exhaustive OpenType conformance or every fallback glyph.",
    "Font declarations freeze at initialization; hot replacement of a catalog is not supported.",
    "Collections, custom factory declarations and multi-value transactions remain outside this reflected scalar resource slice.",
    "The compatible focused population is not repository-wide regression coverage."
  ]
}
