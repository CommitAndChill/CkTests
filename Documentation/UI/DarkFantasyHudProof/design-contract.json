{
  "version": 1,
  "proof": "DarkFantasyHudProof",
  "gym": "UI: Dark Fantasy HUD",
  "gameMode": "ACk_DarkFantasyHud_GameMode",
  "widget": "UCk_DarkFantasyHud_Widget",
  "reference": "User-supplied dark fantasy action RPG HUD; composition and control types",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fit": "ScaleToFit",
    "targetResolutions": [
      [
        1280,
        720
      ],
      [
        1920,
        1080
      ],
      [
        2560,
        1440
      ]
    ]
  },
  "regions": [
    "main"
  ],
  "scalars": {
    "Text": [
      "Selection",
      "SelectionLabel",
      "HealthText",
      "ManaText",
      "ActionStatus"
    ],
    "Number": [
      "HealthFraction",
      "ManaFraction"
    ],
    "Bool": [
      "WheelOpen"
    ],
    "Image": [
      "Minimap",
      "HudFrame"
    ]
  },
  "actions": [
    "OpenWheel",
    "CloseWheel",
    "ActivateSelection"
  ],
  "itemActions": [
    "SelectInteraction",
    "ActivateInteraction"
  ],
  "collections": {
    "Interactions": {
      "schema": {
        "actor": "Text",
        "glyph": "Text",
        "angle": "Number",
        "cooldown": "Number",
        "enabled": "Bool",
        "queued": "Bool"
      },
      "keys": [
        "greet",
        "thanks",
        "follow",
        "wait",
        "help",
        "trade",
        "inspect",
        "leave"
      ],
      "angles": [
        0,
        45,
        90,
        135,
        180,
        225,
        270,
        315
      ],
      "minimumAngularSeparation": 15,
      "initialCooldown": 0,
      "initialEnabled": true,
      "initialQueued": false
    }
  },
  "requiredRegistrations": [
    "HudControls",
    "RadialControls"
  ],
  "art": {
    "dungeon-backdrop.png": {
      "owner": "UMG Image",
      "purpose": "Scenery only"
    },
    "sewer-minimap.png": {
      "binding": "Minimap",
      "widget": "minimap",
      "size": [
        280,
        280
      ],
      "purpose": "Illustrative map only"
    },
    "ornamental-hud-frame.png": {
      "binding": "HudFrame",
      "widget": "ornamental-frame",
      "size": [
        960,
        347
      ],
      "purpose": "Transparent decoration only"
    }
  },
  "ownership": {
    "html": "Widget tree, labels and hints",
    "css": "Layout and appearance",
    "script": "State, keyed interaction records, actions, requests and lifecycle",
    "native": "Generic reflected session, HUD and radial controls"
  },
  "verification": "100-node source contract, Development build, 35/35 DX11 UiAuthoring compatibility tests, and native 720p/1080p/1440p captures; DX12 and cooked packaging open",
