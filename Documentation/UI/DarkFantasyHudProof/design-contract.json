    "Text": [
      "Selection",
      "SelectionLabel",
      "HealthText",
      "ManaText",
      "ActionStatus"
    ],
    "Number": [
      "HealthFraction",
      "ManaFraction",
      "SkillCooldown",
      "CooldownReady",
      "CooldownFlurry",
      "CooldownStrike"
    ],
    "Bool": [
      "WheelOpen"
    ],
