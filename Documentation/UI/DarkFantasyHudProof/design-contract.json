    "Interactions": {
      "schema": {
        "actor": "Text",
        "glyph": "Text",
        "angle": "Number",
        "cooldown": "Number",
        "enabled": "Bool",
        "queued": "Bool",
        "image": "Image"
      },
      "keys": [
        "greet",
        "thanks",
        "follow",
        "wait",
        "help",
        "trade",
        "inspect",
        "leave"
      ],
      "angles": [
        -90,
        -45,
        0,
        45,
        90,
        135,
        180,
        225
      ],
      "minimumAngularSeparation": 15,
      "initialCooldown": 0,
      "initialEnabled": true,
      "initialQueued": false
    }
  },
