    "width": 1920,
    "height": 1080,
    "fit": "ScaleToFit",
    "targetResolutions": [
      [
        1280,
        720
      ],
      [
        1920,
        1080
      ],
      [
        2400,
        1350
      ]
    ]
  },
  "regions": [
    "main"
  ],
